#!/usr/bin/env python3
"""Fake `sacct` for the mock harness (tests/mockpipe.py).

Stands in for SLURM's `sacct`. The engine calls:
  sacct -j <id,id,...> --format=JobID,State,ExitCode,Elapsed,MaxRSS --parsable2 --noheader

For each requested id present in `$SACCT_STATES` (JSON: id -> {state, elapsed,
maxrss}), emit one `--parsable2` row. Ids absent from the map produce no row —
the engine treats that as "not in sacct yet: leave live", exactly as a real
just-submitted job that hasn't landed in accounting.
"""
import json
import os
import pathlib
import sys


def requested_ids(argv):
    for i, tok in enumerate(argv):
        if tok == "-j" and i + 1 < len(argv):
            return [x for x in argv[i + 1].split(",") if x]
    return []


def main():
    argv = sys.argv[1:]
    states_path = os.environ.get("SACCT_STATES")
    states = json.loads(pathlib.Path(states_path).read_text()) if states_path else {}
    for jid in requested_ids(argv):
        info = states.get(str(jid))
        if not info:
            continue
        state = info["state"]
        elapsed = info.get("elapsed", "00:00:30")
        maxrss = info.get("maxrss", "100M")
        print(f"{jid}|{state}|0:0|{elapsed}|{maxrss}")


if __name__ == "__main__":
    main()
